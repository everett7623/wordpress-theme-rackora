{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rackora/home-heading",
	"title": "Home heading",
	"category": "rackora",
	"icon": "heading",
	"description": "Eyebrow, site title as the page H1, tagline, post count and a short line.",
	"textdomain": "rackora",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"tagline": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "rackora-editor",
	"render": "file:./render.php",
	"style": "file:./style.css"
}
