{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rackora/related-posts",
	"title": "Related posts",
	"category": "rackora",
	"icon": "networking",
	"description": "Posts from the same primary category, falling back to the first tag.",
	"textdomain": "rackora",
	"attributes": {
		"count": {
			"type": "number",
			"default": 4,
			"minimum": 2,
			"maximum": 10
		},
		"layout": {
			"type": "string",
			"enum": [ "footer", "sidebar" ],
			"default": "footer"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"includeCurrent": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false
	},
	"editorScript": "rackora-editor",
	"render": "file:./render.php"
}
