{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rackora/post-series",
	"title": "Post series",
	"category": "rackora",
	"icon": "list-view",
	"description": "Lists other posts with the same series name, ordered by the series order field.",
	"textdomain": "rackora",
	"attributes": {
		"count": {
			"type": "number",
			"default": 6,
			"minimum": 3,
			"maximum": 10
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false
	},
	"editorScript": "rackora-editor",
	"render": "file:./render.php"
}
